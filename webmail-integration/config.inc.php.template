<?php
/**
 * config.inc.php.template
 * ================================================================
 * این فایل یک TEMPLATE است، نه فایل نهایی Roundcube. بعد از نصب
 * Roundcube (از roundcube.net دانلود کن، آپلود کن، ویزارد نصب رو اجرا
 * کن)، مقادیر این فایل را با خروجی ویزارد نصب ترکیب کن و به‌عنوان
 * config/config.inc.php واقعی Roundcube ذخیره کن.
 *
 * فقط بخش‌های مهم برای این پروژه اینجا نشان داده شده — بقیه‌ی تنظیمات
 * پیش‌فرض Roundcube را دست‌نخورده نگه دار.
 * ================================================================
 */

$config = [];

/* ---------- اتصال دیتابیس مخصوص خودِ Roundcube (جدا از دیتابیس سایت رسا) ----------
   یک دیتابیس MySQL جدید و جدا از دیتابیس اصلی سایت برایش بساز؛ Roundcube
   جدول‌های خودش (کاربران، پوشه‌ها، تنظیمات شخصی و ...) را در آن می‌سازد. */
$config['db_dsnw'] = 'mysql://DB_USER:DB_PASS@localhost/roundcube_db';

/* ---------- سرور IMAP/SMTP — همون سروری که mailbox ها رویش ساخته می‌شوند ---------- */
$config['imap_host'] = 'ssl://localhost:993';
$config['smtp_host'] = 'tls://localhost:587';
$config['smtp_user'] = '%u'; // از یوزر لاگین‌شده استفاده می‌شود
$config['smtp_pass'] = '%p';

/* ---------- محدودیت حجم پیوست (باید با MAIL_ATTACHMENT_MAX_MB در config.php سایت هماهنگ باشد) ----------
   نکته: این فقط سقف داخلی Roundcube است؛ php.ini هم باید upload_max_filesize
   و post_max_size حداقل هم‌اندازه (یا کمی بیشتر برای overhead) داشته باشد —
   با یک فایل .user.ini کنار Roundcube قابل تنظیم است، مثلاً:
     upload_max_filesize = 11M
     post_max_size = 12M */
$config['max_message_size'] = '10M';

/* ---------- ظاهر و زبان ---------- */
$config['skin'] = 'elastic';       // خودش ریسپانسیو و موبایل‌فرندلیه
$config['language'] = 'fa_IR';
$config['rtl'] = true;

/* ---------- تنظیمات امنیتی پایه ---------- */
$config['des_key'] = 'یک-رشته‌ی-تصادفی-۲۴-کاراکتری-اینجا'; // ویزارد نصب خودش می‌سازه، دست‌نخورده بذار
$config['session_lifetime'] = 30; // دقیقه
$config['force_https'] = true;

/* ---------- پلاگین‌های پیشنهادی برای تجربه‌ی نزدیک‌تر به جیمیل ---------- */
$config['plugins'] = [
    'archive',        // آرشیو ایمیل
    'zipdownload',     // دانلود چند پیوست به‌صورت zip
    'markasjunk',      // علامت‌گذاری اسپم
    'managesieve',     // فیلترهای ایمیل (مثل قوانین جیمیل)
];
